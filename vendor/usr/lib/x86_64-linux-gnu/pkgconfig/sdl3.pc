prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include

Name: sdl3
Description: Simple DirectMedia Layer is a cross-platform multimedia library designed to provide low level access to audio, keyboard, mouse, joystick, 3D hardware via OpenGL, and 2D video framebuffer.
URL: https://www.libsdl.org/
Version: 3.2.10
Requires.private: alsa libpipewire-0.3 >= 0.3.44 libpulse >= 0.9.15 sndio x11 xext xcursor xi xfixes xrandr xscrnsaver libdrm gbm wayland-client >= 1.18 wayland-egl wayland-cursor egl xkbcommon >= 0.5.0 libdecor-0 >= 0.2.0
Conflicts:
Libs: -L${libdir}  -lSDL3 
Libs.private: -pthread -lm
Cflags: -I${includedir} 
