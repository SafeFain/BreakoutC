#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @NEON_VERSION_MAJOR@,@NEON_VERSION_MINOR@,@NEON_VERSION_PATCH@,@NEON_VERSION_WIN_BUILD@
 PRODUCTVERSION @NEON_VERSION_MAJOR@,@NEON_VERSION_MINOR@,@NEON_VERSION_PATCH@,@NEON_VERSION_WIN_BUILD@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Neon Breaker"
            VALUE "FileDescription", "Neon Breaker"
            VALUE "FileVersion", "@NEON_VERSION_DISPLAY@"
            VALUE "InternalName", "neon-breaker"
            VALUE "OriginalFilename", "neon-breaker.exe"
            VALUE "ProductName", "Neon Breaker"
            VALUE "ProductVersion", "@NEON_VERSION_DISPLAY@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
